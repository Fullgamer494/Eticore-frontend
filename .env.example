# Configuración pública para el cliente. Estas variables son visibles en el navegador.
VITE_API_BASE_URL=/api/v1

# Origen de ejemplo para el proxy local de Vite; reemplázalo por tu API.
API_PROXY_TARGET=https://api.example.com

# No colocar secretos, contraseñas ni claves privadas en variables VITE_*.
# Para despliegue, configura VITE_API_BASE_URL con la ruta pública de /api/v1
# y sirve frontend/API bajo un mismo sitio para que la cookie SameSite=Lax funcione.
